import json
import re

import cv2
import numpy as np
import pytesseract

import rclpy
from rclpy.node import Node

from cv_bridge import CvBridge
from sensor_msgs.msg import Image
from std_msgs.msg import String


class VisionNode(Node):

    def __init__(self):
        super().__init__('vision_node')

        # ==========================================================
        # PARAMETERS
        # ==========================================================

        self.declare_parameter('target_shelf', 2)
        self.declare_parameter('book_colour', 'blue')

        self.target_shelf = int(
            self.get_parameter('target_shelf').value
        )

        self.book_colour = str(
            self.get_parameter('book_colour').value
        ).lower()

        # ==========================================================
        # ROS
        # ==========================================================

        self.bridge = CvBridge()

        self.image_sub = self.create_subscription(
            Image,
            '/head_front_camera/head_front_camera/color/image_raw',
            self.image_callback,
            10
        )

        self.detection_pub = self.create_publisher(
            String,
            '/vision/detections',
            10
        )

        # ==========================================================
        # STATE
        # ==========================================================

        self.last_shelf_detection = None
        self.frame_count = 0

        self.get_logger().info(
            '========================================'
        )
        self.get_logger().info(
            'VISION NODE STARTED'
        )
        self.get_logger().info(
            f'Target shelf : {self.target_shelf}'
        )
        self.get_logger().info(
            f'Target book  : {self.book_colour}'
        )
        self.get_logger().info(
            '========================================'
        )

    # ==============================================================
    # CAMERA CALLBACK
    # ==============================================================

    def image_callback(self, msg):

        try:
            image = self.bridge.imgmsg_to_cv2(
                msg,
                desired_encoding='bgr8'
            )
        except Exception as e:

            self.get_logger().error(
                f'Camera conversion failed: {e}'
            )

            return

        self.frame_count += 1

        # ----------------------------------------------------------
        # Detect requested shelf number
        # ----------------------------------------------------------

        shelf = self.detect_shelf_number(image)

        # ----------------------------------------------------------
        # Detect coloured objects/books
        # ----------------------------------------------------------

        books = self.detect_books(image)

        # ----------------------------------------------------------
        # Find requested colour book
        # ----------------------------------------------------------

        target_book = None

        for book in books:

            if book['colour'] != self.book_colour:
                continue

            if target_book is None:
                target_book = book

            elif book['area'] > target_book['area']:
                target_book = book

        # ----------------------------------------------------------
        # Detect green finish area
        # ----------------------------------------------------------

        green_area = self.find_colour_object(
            image,
            'green'
        )

        # ----------------------------------------------------------
        # Detect red area/bin
        # ----------------------------------------------------------

        red_bin = self.find_colour_object(
            image,
            'red'
        )

        # ----------------------------------------------------------
        # Publish result
        # ----------------------------------------------------------

        result = {

            'target_shelf': self.target_shelf,

            'book_colour': self.book_colour,

            'shelf': shelf,

            'target_book': target_book,

            'books': books,

            'red_bin': red_bin,

            'green_area': green_area
        }

        output_msg = String()

        output_msg.data = json.dumps(result)

        self.detection_pub.publish(
            output_msg
        )

        # ----------------------------------------------------------
        # Draw debug information
        # ----------------------------------------------------------

        output = image.copy()

        # Shelf
        if shelf is not None:

            x = shelf['x']
            y = shelf['y']
            w = shelf['w']
            h = shelf['h']

            cv2.rectangle(
                output,
                (x, y),
                (x + w, y + h),
                (255, 0, 255),
                3
            )

            cv2.putText(
                output,
                f"SHELF {shelf['number']}",
                (x, max(y - 10, 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (255, 0, 255),
                2
            )

        # Target book
        if target_book is not None:

            x = target_book['x']
            y = target_book['y']
            w = target_book['w']
            h = target_book['h']

            cv2.rectangle(
                output,
                (x, y),
                (x + w, y + h),
                (255, 255, 255),
                3
            )

            cv2.putText(
                output,
                f"TARGET {self.book_colour.upper()}",
                (x, max(y - 10, 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (255, 255, 255),
                2
            )

        # Status
        shelf_status = (
            f"SHELF {self.target_shelf}: FOUND"
            if shelf is not None
            else f"SHELF {self.target_shelf}: SEARCHING"
        )

        cv2.putText(
            output,
            shelf_status,
            (10, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (255, 255, 255),
            2
        )

        cv2.putText(
            output,
            f"BOOK: {self.book_colour.upper()}",
            (10, 60),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (255, 255, 255),
            2
        )

        cv2.imshow(
            'Competition Vision',
            output
        )

        cv2.waitKey(1)

    # ==============================================================
    # SHELF NUMBER DETECTION
    # ==============================================================

    def detect_shelf_number(self, image):

        height, width = image.shape[:2]

        # Shelf number is overhead.
        # Search upper part of image.
        roi_height = int(height * 0.60)

        roi = image[
            0:roi_height,
            0:width
        ]

        # Upscale OCR image
        scale = 2.0

        roi = cv2.resize(
            roi,
            None,
            fx=scale,
            fy=scale,
            interpolation=cv2.INTER_CUBIC
        )

        gray = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2GRAY
        )

        # Improve contrast
        gray = cv2.GaussianBlur(
            gray,
            (3, 3),
            0
        )

        # Try thresholding
        _, threshold = cv2.threshold(
            gray,
            0,
            255,
            cv2.THRESH_BINARY + cv2.THRESH_OTSU
        )

        # OCR only digits 1-5
        config = (
            '--psm 11 '
            '-c tessedit_char_whitelist=12345'
        )

        try:

            data = pytesseract.image_to_data(
                threshold,
                config=config,
                output_type=pytesseract.Output.DICT
            )

        except Exception as e:

            self.get_logger().error(
                f'OCR failed: {e}'
            )

            return None

        best_detection = None

        for i, text in enumerate(data['text']):

            text = text.strip()

            if not text:
                continue

            matches = re.findall(
                r'[1-5]',
                text
            )

            if not matches:
                continue

            number = int(matches[0])

            # We ONLY care about requested shelf.
            if number != self.target_shelf:
                continue

            try:
                confidence = float(
                    data['conf'][i]
                )
            except Exception:
                confidence = 0.0

            if confidence < 35.0:
                continue

            x = int(data['left'][i] / scale)
            y = int(data['top'][i] / scale)
            w = int(data['width'][i] / scale)
            h = int(data['height'][i] / scale)

            if w < 5 or h < 5:
                continue

            center_x = x + w // 2

            candidate = {

                'number': number,

                'x': x,
                'y': y,
                'w': w,
                'h': h,

                'center_x': center_x,

                'confidence': confidence
            }

            if (
                best_detection is None
                or confidence > best_detection['confidence']
            ):

                best_detection = candidate

        return best_detection

    # ==============================================================
    # COLOUR OBJECT DETECTION
    # ==============================================================

    def find_colour_object(
        self,
        image,
        colour
    ):

        hsv = cv2.cvtColor(
            image,
            cv2.COLOR_BGR2HSV
        )

        if colour == 'red':

            lower1 = np.array(
                [0, 100, 80]
            )

            upper1 = np.array(
                [10, 255, 255]
            )

            lower2 = np.array(
                [170, 100, 80]
            )

            upper2 = np.array(
                [180, 255, 255]
            )

            mask = (
                cv2.inRange(
                    hsv,
                    lower1,
                    upper1
                )
                |
                cv2.inRange(
                    hsv,
                    lower2,
                    upper2
                )
            )

        elif colour == 'green':

            lower = np.array(
                [35, 70, 50]
            )

            upper = np.array(
                [85, 255, 255]
            )

            mask = cv2.inRange(
                hsv,
                lower,
                upper
            )

        else:

            return None

        kernel = np.ones(
            (5, 5),
            np.uint8
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_OPEN,
            kernel
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_CLOSE,
            kernel
        )

        contours, _ = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        if not contours:
            return None

        largest = max(
            contours,
            key=cv2.contourArea
        )

        area = cv2.contourArea(
            largest
        )

        if area < 300:
            return None

        return cv2.boundingRect(
            largest
        )

    # ==============================================================
    # BOOK DETECTION
    # ==============================================================

    def detect_books(self, image):

        hsv = cv2.cvtColor(
            image,
            cv2.COLOR_BGR2HSV
        )

        colour_ranges = {

            'red': [
                (
                    np.array([0, 80, 60]),
                    np.array([10, 255, 255])
                ),
                (
                    np.array([170, 80, 60]),
                    np.array([180, 255, 255])
                )
            ],

            'green': [
                (
                    np.array([35, 60, 50]),
                    np.array([85, 255, 255])
                )
            ],

            'blue': [
                (
                    np.array([90, 60, 50]),
                    np.array([130, 255, 255])
                )
            ],

            'yellow': [
                (
                    np.array([20, 70, 70]),
                    np.array([35, 255, 255])
                )
            ]
        }

        books = []

        for colour, ranges in colour_ranges.items():

            mask = np.zeros(
                hsv.shape[:2],
                dtype=np.uint8
            )

            for lower, upper in ranges:

                mask |= cv2.inRange(
                    hsv,
                    lower,
                    upper
                )

            kernel = np.ones(
                (3, 3),
                np.uint8
            )

            mask = cv2.morphologyEx(
                mask,
                cv2.MORPH_OPEN,
                kernel
            )

            contours, _ = cv2.findContours(
                mask,
                cv2.RETR_EXTERNAL,
                cv2.CHAIN_APPROX_SIMPLE
            )

            for contour in contours:

                area = cv2.contourArea(
                    contour
                )

                if area < 80:
                    continue

                x, y, w, h = cv2.boundingRect(
                    contour
                )

                if h < 10 or w < 3:
                    continue

                books.append({

                    'colour': colour,

                    'x': int(x),
                    'y': int(y),

                    'w': int(w),
                    'h': int(h),

                    'area': float(area),

                    'center_x': int(x + w / 2),
                    'center_y': int(y + h / 2)
                })

        return books


def main():

    rclpy.init()

    node = VisionNode()

    try:

        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:

        cv2.destroyAllWindows()

        node.destroy_node()

        rclpy.shutdown()


if __name__ == '__main__':
    main()
