import math

import rclpy
from rclpy.node import Node

from geometry_msgs.msg import Twist
from sensor_msgs.msg import LaserScan


class SafetyNode(Node):

    def __init__(self):
        super().__init__('safety_node')

        # ---------------------------------------------------------
        # SAFETY PARAMETERS
        # ---------------------------------------------------------

        # Normal stopping distance
        self.stop_distance = 0.45

        # Extra buffer around the robot
        self.warning_distance = 0.70

        # Angular width used when checking direction of travel
        self.check_angle = math.radians(25.0)

        # Latest LiDAR scan
        self.latest_scan = None

        # Latest navigation command
        self.latest_command = Twist()

        # ---------------------------------------------------------
        # SUBSCRIBERS
        # ---------------------------------------------------------

        self.scan_subscriber = self.create_subscription(
            LaserScan,
            '/scan_front_raw',
            self.scan_callback,
            10
        )

        self.command_subscriber = self.create_subscription(
            Twist,
            '/navigation_cmd_vel',
            self.command_callback,
            10
        )

        # ---------------------------------------------------------
        # PUBLISHER
        # ---------------------------------------------------------

        self.cmd_publisher = self.create_publisher(
            Twist,
            '/cmd_vel',
            10
        )

        # ---------------------------------------------------------
        # TIMER
        # ---------------------------------------------------------

        # Publish the safety-filtered command at 20 Hz.
        self.timer = self.create_timer(
            0.05,
            self.control_loop
        )

        self.get_logger().info('Safety node started')
        self.get_logger().info(
            f'Stop distance = {self.stop_distance:.2f} m'
        )

    # =============================================================
    # LiDAR CALLBACK
    # =============================================================

    def scan_callback(self, msg):

        self.latest_scan = msg

    # =============================================================
    # NAVIGATION COMMAND CALLBACK
    # =============================================================

    def command_callback(self, msg):

        self.latest_command = msg

    # =============================================================
    # MAIN SAFETY LOOP
    # =============================================================

    def control_loop(self):

        # No LiDAR yet -> STOP
        if self.latest_scan is None:

            self.publish_stop()

            return

        command = self.latest_command

        # ---------------------------------------------------------
        # If robot is not supposed to move, simply stop.
        # ---------------------------------------------------------

        if self.command_is_zero(command):

            self.publish_stop()

            return

        # ---------------------------------------------------------
        # Determine whether requested movement is safe.
        # ---------------------------------------------------------

        safe = self.motion_is_safe(command)

        if safe:

            self.cmd_publisher.publish(command)

        else:

            self.get_logger().warn(
                'Unsafe movement detected -> STOP'
            )

            self.publish_stop()

    # =============================================================
    # DETERMINE WHETHER COMMAND IS ZERO
    # =============================================================

    def command_is_zero(self, command):

        return (
            abs(command.linear.x) < 0.001
            and
            abs(command.linear.y) < 0.001
            and
            abs(command.angular.z) < 0.001
        )

    # =============================================================
    # SAFETY CHECK
    # =============================================================

    def motion_is_safe(self, command):

        # ---------------------------------------------------------
        # ROTATION
        # ---------------------------------------------------------
        #
        # For now allow slow rotation as long as there is not an
        # extremely close object around the robot.
        #
        # This prevents the previous problem where rotation could
        # be blocked by an irrelevant front measurement.
        # ---------------------------------------------------------

        if abs(command.angular.z) > 0.01:

            closest = self.closest_valid_distance()

            if closest < self.stop_distance:

                return False

            return True

        # ---------------------------------------------------------
        # TRANSLATIONAL MOVEMENT
        # ---------------------------------------------------------

        angle = self.direction_of_motion(command)

        distance = self.distance_in_direction(angle)

        if distance < self.stop_distance:

            return False

        return True

    # =============================================================
    # DIRECTION OF REQUESTED MOTION
    # =============================================================

    def direction_of_motion(self, command):

        x = command.linear.x
        y = command.linear.y

        return math.atan2(y, x)

    # =============================================================
    # DISTANCE IN A PARTICULAR DIRECTION
    # =============================================================

    def distance_in_direction(self, target_angle):

        scan = self.latest_scan

        closest = float('inf')

        for i, distance in enumerate(scan.ranges):

            angle = (
                scan.angle_min
                +
                i * scan.angle_increment
            )

            difference = self.angle_difference(
                angle,
                target_angle
            )

            # Only inspect rays close to direction of travel
            if abs(difference) > self.check_angle:

                continue

            # Ignore invalid readings
            if math.isnan(distance):
                continue

            if math.isinf(distance):
                continue

            if distance < scan.range_min:
                continue

            if distance > scan.range_max:
                continue

            closest = min(
                closest,
                distance
            )

        return closest

    # =============================================================
    # CLOSEST VALID POINT
    # =============================================================

    def closest_valid_distance(self):

        scan = self.latest_scan

        closest = float('inf')

        for distance in scan.ranges:

            if math.isnan(distance):
                continue

            if math.isinf(distance):
                continue

            if distance < scan.range_min:
                continue

            if distance > scan.range_max:
                continue

            closest = min(
                closest,
                distance
            )

        return closest

    # =============================================================
    # ANGLE DIFFERENCE
    # =============================================================

    def angle_difference(self, a, b):

        difference = a - b

        return math.atan2(
            math.sin(difference),
            math.cos(difference)
        )

    # =============================================================
    # STOP
    # =============================================================

    def publish_stop(self):

        stop = Twist()

        self.cmd_publisher.publish(stop)

    # =============================================================
    # SHUTDOWN
    # =============================================================

    def destroy_node(self):

        self.publish_stop()

        super().destroy_node()


def main():

    rclpy.init()

    node = SafetyNode()

    try:

        rclpy.spin(node)

    except KeyboardInterrupt:

        pass

    finally:

        node.publish_stop()

        node.destroy_node()

        rclpy.shutdown()


if __name__ == '__main__':

    main()
