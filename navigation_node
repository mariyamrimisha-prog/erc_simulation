import json
import math

import rclpy
from rclpy.node import Node

from geometry_msgs.msg import Twist
from sensor_msgs.msg import LaserScan
from std_msgs.msg import String


class NavigationNode(Node):

    def __init__(self):
        super().__init__('navigation_node')

        # ==========================================================
        # ROS
        # ==========================================================

        self.cmd_pub = self.create_publisher(
            Twist,
            '/navigation_cmd_vel',
            10
        )

        self.scan_sub = self.create_subscription(
            LaserScan,
            '/scan_front_raw',
            self.scan_callback,
            10
        )

        self.vision_sub = self.create_subscription(
            String,
            '/vision/detections',
            self.vision_callback,
            10
        )

        self.timer = self.create_timer(
            0.1,
            self.navigation_loop
        )

        # ==========================================================
        # SENSOR STATE
        # ==========================================================

        self.latest_scan = None
        self.shelf = None

        # ==========================================================
        # CAMERA
        # ==========================================================

        # Current camera is 640 pixels wide.
        self.camera_center = 320

        # Shelf does not need to be perfectly centered.
        self.center_tolerance = 60

        # ==========================================================
        # SPEEDS
        # ==========================================================

        self.search_turn_speed = 0.12

        self.align_turn_speed = 0.18

        self.forward_speed = 0.10

        self.slow_forward_speed = 0.06

        self.obstacle_turn_speed = 0.25

        # ==========================================================
        # DISTANCES
        # ==========================================================

        # Start avoiding obstacles before they are dangerously close.
        self.obstacle_distance = 0.90

        # Emergency stop.
        self.emergency_distance = 0.45

        # Stop when sufficiently close to shelf.
        self.shelf_stop_distance = 0.70

        # ==========================================================
        # NAVIGATION STATE
        # ==========================================================

        self.state = 'SEARCHING'

        self.obstacle_turning = False

        self.obstacle_turn_direction = 1.0

        # ==========================================================
        # LOGGING
        # ==========================================================

        self.last_state = None

        self.get_logger().info(
            '=========================================='
        )

        self.get_logger().info(
            'AUTONOMOUS SHELF NAVIGATION STARTED'
        )

        self.get_logger().info(
            '=========================================='
        )

    # ==============================================================
    # LiDAR CALLBACK
    # ==============================================================

    def scan_callback(self, msg):

        self.latest_scan = msg

    # ==============================================================
    # VISION CALLBACK
    # ==============================================================

    def vision_callback(self, msg):

        try:

            data = json.loads(
                msg.data
            )

        except Exception:

            return

        shelf = data.get(
            'shelf'
        )

        if shelf is not None:

            self.shelf = shelf

            if self.state == 'SEARCHING':

                self.state = 'ALIGNING'

    # ==============================================================
    # GET DISTANCE IN SECTOR
    # ==============================================================

    def get_sector_distance(
        self,
        center_angle,
        half_width
    ):

        if self.latest_scan is None:

            return float('inf')

        scan = self.latest_scan

        closest = float('inf')

        for i, distance in enumerate(
            scan.ranges
        ):

            if math.isnan(distance):
                continue

            if math.isinf(distance):
                continue

            if distance < scan.range_min:
                continue

            if distance > scan.range_max:
                continue

            angle = (
                scan.angle_min
                + i * scan.angle_increment
            )

            difference = math.atan2(
                math.sin(
                    angle - center_angle
                ),
                math.cos(
                    angle - center_angle
                )
            )

            if abs(difference) <= half_width:

                closest = min(
                    closest,
                    distance
                )

        return closest

    # ==============================================================
    # FRONT
    # ==============================================================

    def get_front_distance(self):

        return self.get_sector_distance(
            0.0,
            math.radians(25)
        )

    # ==============================================================
    # LEFT
    # ==============================================================

    def get_left_distance(self):

        return self.get_sector_distance(
            math.radians(60),
            math.radians(30)
        )

    # ==============================================================
    # RIGHT
    # ==============================================================

    def get_right_distance(self):

        return self.get_sector_distance(
            math.radians(-60),
            math.radians(30)
        )

    # ==============================================================
    # PUBLISH STOP
    # ==============================================================

    def stop(self):

        command = Twist()

        self.cmd_pub.publish(
            command
        )

    # ==============================================================
    # MAIN NAVIGATION LOOP
    # ==============================================================

    def navigation_loop(self):

        command = Twist()

        # ==========================================================
        # SAFETY: NO LIDAR DATA
        # ==========================================================

        if self.latest_scan is None:

            self.set_state(
                'NO_LIDAR'
            )

            self.cmd_pub.publish(
                command
            )

            return

        # ==========================================================
        # READ DISTANCES
        # ==========================================================

        front = self.get_front_distance()

        left = self.get_left_distance()

        right = self.get_right_distance()

        # ==========================================================
        # EMERGENCY STOP
        # ==========================================================

        if front < self.emergency_distance:

            self.set_state(
                'EMERGENCY_STOP'
            )

            command.linear.x = 0.0
            command.linear.y = 0.0
            command.angular.z = 0.0

            self.cmd_pub.publish(
                command
            )

            return

        # ==========================================================
        # OBSTACLE AHEAD
        # ==========================================================

        if front < self.obstacle_distance:

            # If we are already turning around an obstacle,
            # keep turning until front is clear.
            if self.obstacle_turning:

                if front > self.obstacle_distance + 0.20:

                    self.obstacle_turning = False

                    self.set_state(
                        'REACQUIRE_SHELF'
                    )

                else:

                    self.set_state(
                        'AVOIDING_OBSTACLE'
                    )

                    command.linear.x = 0.0

                    command.angular.z = (
                        self.obstacle_turn_speed
                        * self.obstacle_turn_direction
                    )

                    self.cmd_pub.publish(
                        command
                    )

                    return

            else:

                self.obstacle_turning = True

                # Choose the more open side.
                if left > right:

                    self.obstacle_turn_direction = 1.0

                    direction = 'LEFT'

                else:

                    self.obstacle_turn_direction = -1.0

                    direction = 'RIGHT'

                self.set_state(
                    'AVOIDING_OBSTACLE'
                )

                self.get_logger().warn(
                    f'Obstacle ahead: {front:.2f} m '
                    f'-> turning {direction}'
                )

                command.linear.x = 0.0

                command.angular.z = (
                    self.obstacle_turn_speed
                    * self.obstacle_turn_direction
                )

                self.cmd_pub.publish(
                    command
                )

                return

        # ==========================================================
        # IF WE WERE AVOIDING, REACQUIRE SHELF
        # ==========================================================

        if self.obstacle_turning:

            self.obstacle_turning = False

            self.set_state(
                'REACQUIRE_SHELF'
            )

        # ==========================================================
        # NO SHELF VISIBLE
        # ==========================================================

        if self.shelf is None:

            self.set_state(
                'SEARCHING'
            )

            command.linear.x = 0.0

            command.angular.z = (
                self.search_turn_speed
            )

            self.cmd_pub.publish(
                command
            )

            return

        # ==========================================================
        # SHELF DETECTED
        # ==========================================================

        shelf_x = self.shelf.get(
            'center_x',
            self.camera_center
        )

        error = (
            shelf_x
            - self.camera_center
        )

        # ==========================================================
        # SHELF LEFT
        # ==========================================================

        if error < -self.center_tolerance:

            self.set_state(
                'ALIGNING_LEFT'
            )

            command.linear.x = 0.0

            # For YOUR simulation we are reversing the previous
            # camera/base direction mapping.
            command.angular.z = -self.align_turn_speed

            self.cmd_pub.publish(
                command
            )

            return

        # ==========================================================
        # SHELF RIGHT
        # ==========================================================

        if error > self.center_tolerance:

            self.set_state(
                'ALIGNING_RIGHT'
            )

            command.linear.x = 0.0

            command.angular.z = self.align_turn_speed

            self.cmd_pub.publish(
                command
            )

            return

        # ==========================================================
        # SHELF IS CENTERED
        # ==========================================================

        distance = front

        # ----------------------------------------------------------
        # Very close
        # ----------------------------------------------------------

        if distance < self.shelf_stop_distance:

            self.set_state(
                'SHELF_REACHED'
            )

            command.linear.x = 0.0
            command.angular.z = 0.0

            self.cmd_pub.publish(
                command
            )

            return

        # ----------------------------------------------------------
        # Getting close
        # ----------------------------------------------------------

        if distance < 1.2:

            self.set_state(
                'APPROACHING_SHELF_SLOW'
            )

            command.linear.x = (
                self.slow_forward_speed
            )

            command.angular.z = 0.0

        # ----------------------------------------------------------
        # Normal approach
        # ----------------------------------------------------------

        else:

            self.set_state(
                'APPROACHING_SHELF'
            )

            command.linear.x = (
                self.forward_speed
            )

            command.angular.z = 0.0

        self.cmd_pub.publish(
            command
        )

    # ==============================================================
    # STATE LOGGING
    # ==============================================================

    def set_state(self, state):

        if state == self.last_state:

            return

        self.last_state = state

        self.state = state

        self.get_logger().info(
            f'NAVIGATION STATE -> {state}'
        )

    # ==============================================================
    # SHUTDOWN
    # ==============================================================

    def destroy_node(self):

        self.stop()

        super().destroy_node()


def main():

    rclpy.init()

    node = NavigationNode()

    try:

        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:

        node.stop()

        node.destroy_node()

        rclpy.shutdown()


if __name__ == '__main__':
    main()
